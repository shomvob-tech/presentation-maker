# Copy to .env.local for local dev. In CI/CD these are injected by Jenkins
# credentials — see Jenkinsfile.

# --- Runtime, server-only: usage-log audit sheet (lib/audit/sheets.ts) -----
# All three required together to enable audit logging; if any is missing,
# logging is silently skipped (isAuditConfigured() returns false).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Base64-encoded PEM private key (preferred — avoids newline-mangling).
GOOGLE_PRIVATE_KEY_B64=
# Raw PEM fallback with literal \n's, only used if GOOGLE_PRIVATE_KEY_B64 is unset.
# GOOGLE_PRIVATE_KEY=
AUDIT_SHEET_ID=
# Optional, defaults to "events".
AUDIT_SHEET_TAB=events

# --- Runtime, server-only: /dashboard login (lib/audit/auth.ts) ------------
# Both fall back to hardcoded literals ("admin" / "Whatis?") if unset — set
# these in prod so the real login isn't the value sitting in git history.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Signs the dashboard session cookie. Falls back to a public constant if
# unset, which makes the signature forgeable — always set this in prod.
DASHBOARD_SESSION_SECRET=

# --- Runtime, server-only: HRIS proposal API (app/api/v1/hris/proposals) --
# All three required; without them the endpoint answers 503. Table and
# bucket come from supabase/pb_hris_documents.sql (run once).
SUPABASE_URL=
# Service-role key — bypasses RLS. Never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_KEY=
# Shared with HRIS, sent as the x-api-key header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different key per environment.
HRIS_API_KEY=
# Comma-separated origins allowed to call the API from a browser. Exact
# matches, scheme included. Non-browser callers (curl, the test script)
# don't need to be listed.
HRIS_ALLOWED_ORIGINS=http://localhost:3000
# Optional. Where server-side Chromium loads /proposal-preview from; defaults
# to http://localhost:$PORT in dev and http://127.0.0.1:$PORT in production.
# Set it if `next dev` runs on another port.
# INTERNAL_BASE_URL=

# --- Not needed ---------------------------------------------------------
# CHROMIUM_PACK_URL is only read when process.env.VERCEL is set
# (lib/launch-browser.ts) — on EC2 the Docker image bundles Playwright's own
# Chromium instead, so this is unused outside Vercel.
#
# NEXT_PUBLIC_PRESENTATION_API_URL (lib/presentation-api.ts) — the only
# function that reads it, submitClientDetails(), isn't called from anywhere
# in app/. Confirmed dead code; not wired into the Jenkins pipeline.
