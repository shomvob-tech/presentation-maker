# Copy to .env.local for local dev. In CI/CD these are injected by Jenkins
# credentials — see Jenkinsfile and deploy/docker-compose.yml.

# --- Build-time, public (inlined into the browser bundle at `next build`) --
# Base URL of the presentation backend API. Required in prod — defaults to
# http://localhost:8000/api/presentations otherwise. (lib/presentation-api.ts)
NEXT_PUBLIC_PRESENTATION_API_URL=

# --- Runtime, server-only: usage-log audit sheet (lib/audit/sheets.ts) -----
# All three required together to enable audit logging; if any is missing,
# logging is silently skipped (isAuditConfigured() returns false).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Base64-encoded PEM private key (preferred — avoids newline-mangling).
GOOGLE_PRIVATE_KEY_B64=
# Raw PEM fallback with literal \n's, only used if GOOGLE_PRIVATE_KEY_B64 is unset.
# GOOGLE_PRIVATE_KEY=
AUDIT_SHEET_ID=
# Optional, defaults to "events".
AUDIT_SHEET_TAB=events

# --- Runtime, server-only: /dashboard login (lib/audit/auth.ts) ------------
# Both fall back to hardcoded literals ("admin" / "Whatis?") if unset — set
# these in prod so the real login isn't the value sitting in git history.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Signs the dashboard session cookie. Falls back to a public constant if
# unset, which makes the signature forgeable — always set this in prod.
DASHBOARD_SESSION_SECRET=

# --- Not needed on EC2 ------------------------------------------------------
# CHROMIUM_PACK_URL is only read when process.env.VERCEL is set
# (lib/launch-browser.ts) — on EC2 the Docker image bundles Playwright's own
# Chromium instead, so this is unused outside Vercel.
